TELEGRAM_BOT_TOKEN=telegram_bot_tokeningiz
MONGODB_URI=mongodb+srv://<foydalanuvchi>:<parol>@<cluster>.mongodb.net
MONGODB_DB=telegram_bot
TOKEN_SECRET=64-ta_hex_belgili_tasodifiy_secret
CRON_SECRET=32-ta_belgili_tasodifiy_secret
ADMIN_IDS=123456789
MAX_BOTS_PER_USER=3
PORT=3000
# Ommaviy HTTPS domen; SMM foydalanuvchi API manzili /api/smm/<bot-id>/v2 bo'ladi.
# POST amallari: services, balance, add(service/link/quantity), status(order/orders).
PUBLIC_API_URL=https://your-domain.example

# Bot foydalanuvchilariga umumiy SMM provider hisob ma'lumoti; balanslar alohida.
SMM_API_URL=
SMM_API_KEY=
SMM_USD_RATE=12700
SMM_MARKUP_PERCENT=30
SMM_CARD_NUMBER=
SMM_CARD_OWNER=

# Jamendo developer client ID for music search bots.
JAMENDO_CLIENT_ID=
